<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Served by the /.well-known UseStaticFiles block in Program.cs, which sets the right content types -->
    <StaticWebAssetEndpointExclusionPattern>.well-known/**</StaticWebAssetEndpointExclusionPattern>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.103.0" />
  </ItemGroup>

</Project>
