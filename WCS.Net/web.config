<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WCS.Net.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>

  <!--
    Requests under /.well-known/ must go through the aspNetCore handler only.
    IIS inherits extension-specific static-file handlers (for .txt, etc.) from the
    platform's applicationHost.config, and those outrank the wildcard "aspNetCore"
    handler added below since this web.config never clears the inherited list. That
    let IIS's own native static-file handling take these requests instead of the app
    - failing outright for extensionless files (500) and returning empty/missing
    content for the rest, because IIS doesn't reliably serve a dot-prefixed folder
    under Windows App Service. Clearing and re-adding only aspNetCore here forces
    every request under this path into the app, where Program.cs's own
    UseStaticFiles middleware serves the files correctly (verified working locally).
  -->
  <location path=".well-known">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="true" />
        </requestFiltering>
      </security>
      <handlers>
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
