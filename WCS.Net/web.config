<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WCS.Net.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>

  <!--
    Force requests under /.well-known/ through the static-content handler explicitly.
    Files placed there (ACME/Let's Encrypt challenges, api-catalog.json, etc.) are
    correctly served locally, but a dot-prefixed folder name can be treated specially
    by IIS's default handler/serving rules on Windows App Service. This location block
    scopes an explicit allow + a MIME mapping for extensionless files (ACME challenge
    tokens have no file extension) without touching any other path on the site.
  -->
  <location path=".well-known">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="true" />
        </requestFiltering>
      </security>
      <staticContent>
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
