@model ValveViewModel

@{
    var cardClass = Model.Category == ValveCategory.Valve ? "valve-card" : "valve-card valve-card--service";
}

<a class="@cardClass" href="@Model.PagePath">
    <img src="@Model.ThumbnailSrc" alt="@Model.ThumbnailAlt">
    <div class="valve-card-body">
        <span class="kicker">@Model.ShortKicker</span>
        <h3>@Model.Name</h3>
        <p>@Model.Teaser</p>
        <span class="valve-card-link">View details &rarr;</span>
    </div>
</a>
