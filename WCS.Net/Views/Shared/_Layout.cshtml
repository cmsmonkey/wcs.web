<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@(ViewData["Description"] ?? "World Cryo Services — independent cryogenic butterfly valve service and spare parts for LNG carriers.")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @{
        var canonicalPath = Context.Request.Path.Value?.TrimEnd('/') ?? "";
        var canonicalUrl = "https://www.wcryoservices.com" + canonicalPath;
        var markdownPath = string.IsNullOrEmpty(canonicalPath) ? "/index.md" : canonicalPath + ".md";
        var markdownUrl = "https://www.wcryoservices.com" + markdownPath;
    }
    <link rel="canonical" href="@canonicalUrl">
    <link rel="alternate" type="text/markdown" href="@markdownUrl" title="Markdown version of this page">

    <meta name="theme-color" content="#0F75BD">
    <meta name="apple-mobile-web-app-status-bar-style" content="#0F75BD">
    <meta name="msapplication-TileColor" content="#ffffff">

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description"  content="@ViewData["Description"]" />
    <meta name="twitter:image" content="https://www.wcryoservices.com/images/wcryoservices-og-card.jpg" />
    <meta name="twitter:image:alt" content="A frosted cryogenic valve on an LNG carrier, branded World Cryo Services — Independent Cryogenic Valve Service" />

    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="World Cryo Services" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:image" content="https://www.wcryoservices.com/images/wcryoservices-og-card.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A frosted cryogenic valve on an LNG carrier, branded World Cryo Services — Independent Cryogenic Valve Service" />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" sizes="192x192" href="/images/icon/icon-highres.png">
    <link rel="apple-touch-icon" href="/images/icon/touch-icon-iphone.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/icon/touch-icon-ipad.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/touch-icon-iphone-retina.png">
    <link rel="apple-touch-icon" sizes="167x167" href="/images/icon/touch-icon-ipad-retina.png">
    <meta name="msapplication-TileImage" content="/images/icon/touch-icon-144.png">

    <link rel="api-catalog" href="/.well-known/api-catalog">

    <script type="application/ld+json">@Html.Raw(OrganizationSchemaRenderer.Render())</script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3WB4H93GX4"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-3WB4H93GX4');
    </script>


</head>
<body>
    <a href="#top" class="skip-link">Skip to content</a>

    @await Html.PartialAsync("_Header")

    <main id="top" tabindex="-1">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
