@model ValveViewModel

<section class="page-header">
    <div class="wrap">
        <span class="kicker">@Model.Kicker</span>
        <h1>@Model.Name</h1>
        @foreach (var paragraph in Model.IntroParagraphs)
        {
            <p class="lede">@paragraph</p>
        }
    </div>
</section>

<section>
    <div class="wrap">
        <div class="section-head">
            <span class="kicker">Photos</span>
            <h2>@Model.Name in the field and in the workshop</h2>
        </div>
        <div class="photogrid">
            @foreach (var photo in Model.Photos)
            {
                <figure>
                    <img src="@photo.Src" alt="@photo.Alt">
                    @if (!string.IsNullOrEmpty(photo.Caption))
                    {
                        <figcaption>@photo.Caption</figcaption>
                    }
                </figure>
            }
        </div>

        @if (Model.Callout is not null)
        {
            <div class="lpg-callout bracket">
                <span class="bl"></span><span class="br"></span>
                @if (!string.IsNullOrEmpty(Model.Callout.Kicker))
                {
                    <span class="kicker">@Model.Callout.Kicker</span>
                }
                <h3>@Model.Callout.Title</h3>
                <p>@Model.Callout.Body</p>
            </div>
        }
    </div>
</section>

<partial name="_QuoteCta" />
