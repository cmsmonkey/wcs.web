@model ValveViewModel

<script type="application/ld+json">@Html.Raw(ValveSchemaRenderer.Render(Model))</script>

<section class="page-header">
    <div class="wrap">
        <span class="kicker">@Model.Kicker</span>
        <h1>@Model.Name</h1>
        @foreach (var paragraph in Model.IntroParagraphs)
        {
            <p class="lede">@paragraph</p>
        }
    </div>
</section>

<section>
    <div class="wrap">
        <div class="section-head">
            <span class="kicker">Seal Types & Supplies</span>
            <h2>For @Model.Name, we supply</h2>
        </div>
        <ul class="seal-list">
            @foreach (var sealType in Model.SealTypes)
            {
                <li>@sealType</li>
            }
        </ul>
    </div>
</section>

<section>
    <div class="wrap">
        <div class="section-head">
            <span class="kicker">Photos</span>
            <h2>@Model.Name in the field and in the workshop</h2>
        </div>
        <div class="photogrid">
            @foreach (var photo in Model.Photos)
            {
                <figure>
                    <img src="@photo.Src" alt="@photo.Alt">
                    @if (!string.IsNullOrEmpty(photo.Caption))
                    {
                        <figcaption>@photo.Caption</figcaption>
                    }
                </figure>
            }
        </div>

        @if (Model.Callout is not null)
        {
            <div class="lpg-callout bracket">
                <span class="bl"></span><span class="br"></span>
                @if (!string.IsNullOrEmpty(Model.Callout.Kicker))
                {
                    <span class="kicker">@Model.Callout.Kicker</span>
                }
                <h3>@Model.Callout.Title</h3>
                <p>@Model.Callout.Body</p>
            </div>
        }
    </div>
</section>

@if (Model.CaseStudies.Count > 0)
{
    <section style="background:var(--surface-alt);">
        <div class="wrap">
            <div class="section-head">
                <span class="kicker">Case Studies</span>
                <h2>From the workshop: documented @Model.Name repairs</h2>
            </div>
            <div class="case-study-grid">
                @foreach (var caseStudy in Model.CaseStudies)
                {
                    <article class="case-study">
                        <h3>@caseStudy.Title</h3>
                        @foreach (var paragraph in caseStudy.Paragraphs)
                        {
                            <p>@paragraph</p>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (Model.Faqs.Count > 0)
{
    <section>
        <div class="wrap">
            <div class="section-head">
                <span class="kicker">FAQ</span>
                <h2>@Model.Name spare parts & service — frequently asked questions</h2>
            </div>
            <div class="faq-list">
                @foreach (var faq in Model.Faqs)
                {
                    <details>
                        <summary>@faq.Question</summary>
                        <p>@faq.Answer</p>
                    </details>
                }
            </div>
        </div>
    </section>
}

<section style="background:var(--surface-alt);">
    <div class="wrap">
        <div class="section-head">
            <span class="kicker">Other Valve Types</span>
            <h2>Explore the other valve types WCS services</h2>
        </div>
        <div class="valve-cards">
            @foreach (var other in ValveCatalog.AllExcept(Model.Slug))
            {
                <partial name="_ValveCard" model="other" />
            }
        </div>
    </div>
</section>

<partial name="_QuoteCta" />
