@model IReadOnlyList<ValveViewModel>

<section id="parts">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker">Parts We Manufacture &amp; Supply</span>
      <h2>Reverse-engineered, remanufactured, in stock</h2>
      <p style="color:var(--muted); font-size:16px; margin-top:14px;">Like our competitors, WCS outsources soft-seal production to an established plastics specialist. Unlike them, we manufacture our own metal seals in-house in Norway — and remain the only supplier for some discontinued valve types.</p>
    </div>

    <div class="valve-cards">
      @foreach (var valve in Model)
      {
          <a class="valve-card" asp-controller="Valves" asp-action="Show" asp-route-slug="@valve.Slug">
              <img src="@valve.ThumbnailSrc" alt="@valve.ThumbnailAlt">
              <div class="valve-card-body">
                  <span class="kicker">@valve.Kicker</span>
                  <h3>@valve.Name</h3>
                  <p>@valve.Teaser</p>
                  <span class="valve-card-link">View details &rarr;</span>
              </div>
          </a>
      }
    </div>
  </div>
</section>
